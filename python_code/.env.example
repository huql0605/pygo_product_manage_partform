# 复制为 .env 后按实际环境填写：cp .env.example .env
# 变量名由 app/config.py 中的 validation_alias 决定，不能改名

# SQLAlchemy 连接串，注意驱动是 psycopg2
DATABASE_URL=postgresql+psycopg2://change_me:change_me@localhost:5432/db1

# 反向调用 Go 服务时使用
GO_API=http://127.0.0.1:8080

# 与 Go 共享的 HMAC 密钥，两边必须完全相同
IMPORT_SIGNING_KEY=change_me

# 属性聚合允许查询的 key，逗号分隔；设为 * 表示放行任意合法命名的 key
ALLOWED_ATTRS=storage,screen,cpu,ram,color,weight


MAX_UPLOAD_BYTES=33554432