# 复制为 .env 后按实际环境填写：cp .env.example .env
# 这些变量会覆盖 configs/configs.yaml 中的同名配置（见 internal/config/config.go 的 applyEnvOverrides）

DB_HOST=localhost
DB_PORT=5432
DB_USER=change_me
DB_PASSWORD=change_me
DB_NAME=db1

# Python 上传接口与 Go 共享的 HMAC 密钥，两边必须完全相同
IMPORT_SIGNING_KEY=change_me

# Go 转发分析请求时使用的 Python 服务地址
PYTHON_BASE_URL=http://127.0.0.1:8000